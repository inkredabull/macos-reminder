{
  "name": "@inkredabull/macos-reminder",
  "version": "1.2.0",
  "description": "A TypeScript library for creating and managing macOS reminders via AppleScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "macos",
    "reminders",
    "applescript",
    "automation",
    "productivity",
    "typescript"
  ],
  "author": "inkredabull",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "config/**/*",
    "README.md"
  ],
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "os": [
    "darwin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/inkredabull/macos-reminder.git"
  },
  "bugs": {
    "url": "https://github.com/inkredabull/macos-reminder/issues"
  },
  "homepage": "https://github.com/inkredabull/macos-reminder#readme"
